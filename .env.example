# Local: copy to `.env`. Vercel: Settings → Environment Variables → Import (.env / .env.example).
# Enable Production + Preview (+ Development if you use Vercel env in dev).

# Required for cloud sync (server only — never exposed to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required in production (Vercel) — signs the login cookie
APP_SESSION_SECRET=

# Required in production (Vercel) — portal login password (case-sensitive)
ADMARK_APP_PASSWORD=

# Optional — portal username (default: Admark Digitals). Not case-sensitive; spaces normalized.
# ADMARK_APP_USERNAME=

# Optional — "Home" nav URL (default is `/` in this app). Set to an absolute URL only if Home should open an external site.
# VITE_PUBLIC_HOME_URL=

# Relational migration (after `npm run db:migrate:apply`)
# RELATIONAL_DUAL_WRITES_ENABLED=true   # mirror saves to admark.* tables
# RELATIONAL_READS_ENABLED=true         # read from admark.* instead of JSON (enable after validate passes)

# Local: copy to `.env`. Vercel: Settings → Environment Variables → Import (.env / .env.example).
# Enable Production + Preview (+ Development if you use Vercel env in dev).

# Required for cloud sync (server only — never exposed to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required — signs the login cookie (min 16 chars). Never commit a real value.
# In production this is mandatory; in local/dev a known fallback is used only if unset.
APP_SESSION_SECRET=

# Required — portal login password (case-sensitive). No hardcoded defaults.
# Must NOT be HTRP@2026, Admin@123, or other known insecure values in production.
ADMARK_APP_PASSWORD=

# Optional — portal username (default: Admark Digitals). Not case-sensitive; spaces normalized.
# ADMARK_APP_USERNAME=

# Optional — "Home" nav URL (default is `/` in this app). Set to an absolute URL only if Home should open an external site.
# VITE_PUBLIC_HOME_URL=

# Relational mode (defaults ON in app code — leave unset or true). Never set false:
# legacy JSON blobs are retired and burned multi-GB Supabase egress.
# RELATIONAL_READS_ENABLED=true
# RELATIONAL_DUAL_WRITES_ENABLED=true

# Heavy migrate/inspect/restore scripts refuse to run unless acknowledged:
#   ALLOW_HEAVY_SUPABASE_SCRIPTS=1 node scripts/migrate-json-to-relational.mjs
#   # or pass --allow-egress
# Do not put ALLOW_HEAVY_SUPABASE_SCRIPTS=1 in this file for normal work.
